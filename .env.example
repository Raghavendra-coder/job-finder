# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# Job Portal Credentials - LinkedIn
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password

# Job Portal Credentials - Indeed
INDEED_EMAIL=your-email@example.com
INDEED_PASSWORD=your-password

# Job Portal Credentials - Naukri
NAUKRI_EMAIL=your-email@example.com
NAUKRI_PASSWORD=your-password

# Application Defaults
APPLICANT_NAME=Your Full Name
APPLICANT_EMAIL=your-email@example.com
APPLICANT_PHONE=+1234567890

# Server
HOST=0.0.0.0
PORT=8000

# Proxy (optional)
PROXY_URL=

# Browser (optional): connect to existing Chrome via CDP
# Set true only if Chrome is started with --remote-debugging-port=9222
BROWSER_CONNECT_OVER_CDP=false
CHROME_CDP_URL=http://localhost:9222

# Job Match Threshold (0.0 - 1.0)
MATCH_THRESHOLD=0.5

# Rate Limiting - delays in seconds
MIN_DELAY=2
MAX_DELAY=5

# Authentication (seconds): 0 means wait indefinitely for manual login/captcha
MANUAL_LOGIN_TIMEOUT_SECONDS=0
